/* Separate CTR wire emitter using SwIPC's lexer/AST/output utilities. No HIPC,
   CMIF, domains, alignment sorting, buffer attributes or successful stubs. */
static void ctr_check_cmd(Cmd* c) {
    int i, j, pid = 0;
    unsigned long normal[2] = {0, 0}, translated[2] = {0, 0};
    if (c->id > 65535) fail_at(c->line, "CTR command id exceeds 16 bits");
    if (c->stub || c->unsorted) fail_at(c->line, "CTR does not support @stub or @unsorted");
    for (i = c->arg0; i < c->arg0 + c->nargs; ++i) {
        Arg* a = &args[i];
        Type* t = &types[resolve(a->type)];
        for (j = c->arg0; j < i; ++j)
            if (!strcmp(args[j].name, a->name)) fail_at(c->line, "two CTR arguments named %s", a->name);
        a->offset = normal[a->out] + (a->out ? 2 : 1);
        if (t->kind == TK_PID && !a->out) {
            if (pid++) fail_at(c->line, "one CTR pid descriptor at most");
            translated[0] += 2;
        } else if (t->kind == TK_HANDLE && a->out) {
            a->offset = translated[1];
            translated[1] += 2;
        } else if (t->kind == TK_INT && !t->is_signed && (t->size == 4 || t->size == 8)) {
            normal[a->out] += t->size / 4;
        } else if (t->kind == TK_BYTES && t->size <= 240 && !(t->size & 3)) {
            normal[a->out] += t->size / 4;
        } else {
            fail_at(c->line,
                    "unsupported CTR wire type (initial subset: u32/u64/word-sized bytes, pid in, handles out)");
        }
    }
    if (normal[0] > 63 || normal[1] + 1 > 63 || translated[1] > 63 || 1 + normal[0] + translated[0] > 64 ||
        2 + normal[1] + translated[1] > 64)
        fail_at(c->line, "CTR request/reply exceeds 64 command words");
    c->in_size = normal[0];
    c->out_size = normal[1];
    c->ncopy = (int)translated[1];
    c->pid = pid;
}
static void ctr_param(const Arg* a) {
    Type* t = &types[resolve(a->type)];
    if (t->kind == TK_BYTES)
        emit(", %suint8_t* a_%s", a->out ? "" : "const ", a->name);
    else
        emit(", uint%lu_t%s a_%s", t->kind == TK_PID || t->kind == TK_HANDLE ? 32ul : t->size * 8, a->out ? "*" : "",
             a->name);
}
static void ctr_prototype(const Iface* f, const Cmd* c) {
    char name[NAME_LEN * 2];
    int i;
    handler_name(name, f, c);
    emit("static uint32_t %s(SnxCtrIpc* c", name);
    for (i = c->arg0; i < c->arg0 + c->nargs; ++i) ctr_param(&args[i]);
    emit(");\n");
}
static void ctr_header(int fi, const char* out) {
    char path[1024], guard[600], name[NAME_LEN];
    int i;
    guard_name(guard, files[fi].path);
    emit(
        "/* Generated by swipc --ctr. Separate CTR wire format. */\n#ifndef %s\n#define %s\n#include \"ipc/ctr_ipc.h\"\n",
        guard, guard);
    for (i = 0; i < nifaces; ++i) {
        if (ifaces[i].file != fi) continue;
        mangle(name, ifaces[i].name);
        emit("void %s_dispatch(SnxCtrIpc* c);\n", name);
    }
    emit("#endif\n");
    sprintf(path, "%s/%s.h", out, files[fi].path);
    flush(path);
}
static void ctr_unpack(const Iface* f, const Cmd* c) {
    char name[NAME_LEN * 2], cn[NAME_LEN];
    int i;
    handler_name(name, f, c);
    mangle(cn, f->name);
    emit("static void %s__%lu(SnxCtrIpc* c) {\n    uint32_t result;\n", cn, c->id);
    for (i = c->arg0; i < c->arg0 + c->nargs; ++i) {
        const Arg* a = &args[i];
        Type* t = &types[resolve(a->type)];
        if (t->kind == TK_BYTES)
            emit("    uint8_t a_%s[%lu] = {0};\n", a->name, t->size);
        else
            emit("    uint%lu_t a_%s = 0;\n", t->kind == TK_PID || t->kind == TK_HANDLE ? 32ul : t->size * 8, a->name);
    }
    emit("    if (!snx_ctr_ipc_expect(c, %lu, %d)) return;\n", c->in_size, c->pid ? 2 : 0);
    if (c->pid) emit("    if (c->in[%lu] != 0x20) { snx_ctr_ipc_bad(c); return; }\n", c->in_size + 1);
    for (i = c->arg0; i < c->arg0 + c->nargs; ++i) {
        const Arg* a = &args[i];
        Type* t = &types[resolve(a->type)];
        if (a->out) continue;
        if (t->kind == TK_PID)
            emit("    a_%s = c->caller_pid;\n", a->name);
        else if (t->kind == TK_BYTES)
            emit("    snx_ctr_ipc_get_bytes(c, %lu, a_%s, %lu);\n", a->offset, a->name, t->size);
        else if (t->size == 8)
            emit("    a_%s = c->in[%lu] | (uint64_t)c->in[%lu] << 32;\n", a->name, a->offset, a->offset + 1);
        else
            emit("    a_%s = c->in[%lu];\n", a->name, a->offset);
    }
    emit("    if (c->transport_result) return;\n");
    emit("    result = %s(c", name);
    for (i = c->arg0; i < c->arg0 + c->nargs; ++i) {
        const Arg* a = &args[i];
        int kind = types[resolve(a->type)].kind;
        emit(", %sa_%s", a->out && kind != TK_BYTES ? "&" : "", a->name);
    }
    emit(");\n    if (result || c->transport_result || c->state != SNX_CTR_IPC_RETURN) {\n");
    for (i = c->arg0; i < c->arg0 + c->nargs; ++i)
        if (args[i].out && types[resolve(args[i].type)].kind == TK_HANDLE)
            emit("        snx_ctr_ipc_drop_handle(c, a_%s);\n", args[i].name);
    emit("        snx_ctr_ipc_error_reply(c, result);\n        return;\n    }\n");
    emit("    c->out[0] = (c->in[0] & 0xffff0000u) | (%luu << 6) | %d;\n", c->out_size + 1, c->ncopy);
    for (i = c->arg0; i < c->arg0 + c->nargs; ++i) {
        const Arg* a = &args[i];
        Type* t = &types[resolve(a->type)];
        if (!a->out) continue;
        if (t->kind == TK_HANDLE)
            emit("    snx_ctr_ipc_output_handle(c, %lu, 0x%x, a_%s);\n", c->out_size + 2 + a->offset, t->move ? 16 : 0,
                 a->name);
        else if (t->kind == TK_BYTES)
            emit("    snx_ctr_ipc_put_bytes(c, %lu, a_%s, %lu);\n", a->offset, a->name, t->size);
        else {
            emit("    c->out[%lu] = (uint32_t)a_%s;\n", a->offset, a->name);
            if (t->size == 8) emit("    c->out[%lu] = (uint32_t)(a_%s >> 32);\n", a->offset + 1, a->name);
        }
    }
    emit("    if (c->state != SNX_CTR_IPC_RETURN) {\n");
    for (i = c->arg0; i < c->arg0 + c->nargs; ++i)
        if (args[i].out && types[resolve(args[i].type)].kind == TK_HANDLE)
            emit("        snx_ctr_ipc_drop_handle(c, a_%s);\n", args[i].name);
    emit("    }\n}\n");
}
static void ctr_inc(int fi, const char* out) {
    char path[1024], name[NAME_LEN];
    int i, j;
    emit("/* Generated by swipc --ctr. Edit the schema, not this file. */\n#include \"%s.h\"\n", files[fi].path);
    for (i = 0; i < nifaces; ++i) {
        const Iface* f = &ifaces[i];
        if (f->file != fi) continue;
        mangle(name, f->name);
        for (j = f->cmd0; j < f->cmd0 + f->ncmds; ++j) ctr_prototype(f, &cmds[j]);
        for (j = f->cmd0; j < f->cmd0 + f->ncmds; ++j) ctr_unpack(f, &cmds[j]);
        emit("void %s_dispatch(SnxCtrIpc* c) {\n    switch (c->in[0] >> 16) {\n", name);
        for (j = f->cmd0; j < f->cmd0 + f->ncmds; ++j)
            emit("        case %lu: %s__%lu(c); return;\n", cmds[j].id, name, cmds[j].id);
        emit("        default: c->state = SNX_CTR_IPC_UNSUPPORTED; return;\n    }\n}\n");
    }
    sprintf(path, "%s/%s.inc", out, files[fi].path);
    flush(path);
}
