# CTR word-ordered commands, not Switch HIPC/CMIF.
interface snx::ctr::srv is srv: {
    [1] RegisterClient(pid process);
    [5] GetServiceHandle(bytes<8> name, u32 length, u32 flags) -> handle<move, session> session;
}
